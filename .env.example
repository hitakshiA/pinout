# Pinout — Hedera testnet, HBAR only. ECDSA (secp256k1) keys ONLY.
# ED25519 fails silently in EVM-adjacent tooling.
# process.env overrides anything set here; .env is optional.

HEDERA_NETWORK=hedera:testnet
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# Buyer / payer. Also the HIP-991 settlement fee COLLECTOR.
HEDERA_ACCOUNT_ID=0.0.xxxxxxx
HEDERA_PRIVATE_KEY=0x...

# Seller / resource server. Owns both topics, writes all checkpoints.
SELLER_ACCOUNT_ID=0.0.xxxxxxx
SELLER_PRIVATE_KEY=0x...

# Tier 1: plain HCS topic, high-frequency burn checkpoints (~$0.0008/write)
BURN_TOPIC_ID=0.0.xxxxxxx
# Tier 2: HIP-991 fee-charging topic, rare settlement anchors (~$0.050/write)
TOPIC_ID=0.0.xxxxxxx

# Pricing (tinybar)
PRICE_PER_EVENT_TINYBAR=200
SESSION_TINYBAR=400000
TOPUP_TINYBAR=200000
CHECKPOINT_EVERY=250
TOPUP_THRESHOLD=400

# x402 | blocky402
FACILITATOR=x402
PORT=4021
PROVIDER=llm
# Optional: stream real LLM tokens instead of the deterministic corpus
# OPENAI_API_KEY=
