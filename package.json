{
  "name": "pinout",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hashgraph/hedera-agent-kit": "^4.0.0",
    "@hiero-ledger/sdk": "^2.86.2",
    "@hono/node-server": "^2.0.12",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@noble/curves": "^2.2.0",
    "@x402/core": "^2.20.0",
    "@x402/hedera": "^2.20.0",
    "@x402/hono": "^2.20.0",
    "hono": "^4.12.32",
    "zod": "^4.4.3"
  },
  "scripts": {
    "e2e": "node scripts/e2e.mjs",
    "verify": "node scripts/verify.mjs",
    "bench": "node scripts/bench-hcs.mjs",
