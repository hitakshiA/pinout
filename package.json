  },
  "keywords": [
    "x402",
    "hedera",
    "hcs",
    "hip-991",
    "micropayments",
    "streaming",
    "ai-agents",
    "mcp"
  ],
  "exports": {
    ".": "./src/server.mjs",
    "./client": "./src/client.mjs",
    "./agent-kit": "./src/agent-kit-plugin.mjs",
    "./mcp": "./src/mcp.mjs",
    "./verifier": "./src/verifier.mjs"
